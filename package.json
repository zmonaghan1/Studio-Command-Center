{
  "name": "studio-command-center",
  "version": "0.0.0",
  "private": true,
  "description": "Production dashboard for game studios: milestones, blockers and budgets in one place.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
